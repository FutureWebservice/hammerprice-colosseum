    "lucide-react": "^0.446.0",
    "mpl-token-metadata-v3": "npm:@metaplex-foundation/mpl-token-metadata@^3.4.0",
    "next": "15.5.27",
    "next-intl": "^4.9.2",
    "pg": "^8.23.1",
