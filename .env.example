# Hammerprice: every variable the app reads, and nothing that is a secret.
#
# Local run (Node 22), with every optional feature that needs no outside account switched on:
#
#   docker run -d --name hammerprice-pg -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=hammerprice postgres:18
#   cp .env.example .env.local
#   echo "VRF_SECRET_KEY=$(openssl rand -hex 32)" >> .env.local
#   npm ci && npm run db:migrate && npm run dev      # http://localhost:3000/en
#
# That runs the site, but with no rooms and no packs: the house room, its cards and the test pack are minted on devnet, which needs the role
# keys and about 1 devnet SOL once. The first command creates the keys and names the one to fund (faucet.solana.com, choose devnet); run the
# second after funding, then restart dev:
#
#   npm run devnet:bootstrap -- --env
#   npm run devnet:bootstrap -- --env | grep -E '^[A-Z_]+=' >> .env.local
#
# Only DATABASE_URL is required to run or build: without it `npm run build` fails at page-data
# collection with "DATABASE_URL is not set" (src/db/index.ts). Everything else has a default or degrades
# to a clearly labelled empty state. For a deployment, set the values in the host's own environment
# settings (this file is never read there) and use your own database and keys.
# Never paste values into a chat or a commit.

# --- database (required) ----------------------------------------------------------------
# Local: the Postgres of the docker command above. A hosted Neon database works too: use its pooled URL. The app uses
# @neondatabase/serverless over a WebSocket pool for Neon (the HTTP driver cannot run the interactive transactions the
# auction engine needs) and node-postgres when the host is localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hammerprice
# Neon only: the DIRECT URL (no pooler) for migrations (`npm run db:migrate`). drizzle.config.ts reads
# DATABASE_URL_UNPOOLED, then DATABASE_URL_DIRECT, then DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# --- sessions and cron (secrets; different per environment) --------------------------------
# 32+ random bytes: openssl rand -base64 32. Empty is fine for `npm run dev` (a temporary secret per start, so a restart signs
# you out). `npm run build && npm start` counts as a deployment: it needs this and NEXT_PUBLIC_SITE_URL=http://localhost:3000 (below),
# or sign-in answers 503.
SESSION_SECRET=
# Vercel Cron sends this as `Authorization: Bearer`; /api/cron/sweep refuses anything else.
CRON_SECRET=

# --- Solana: ONE switch -------------------------------------------------------------------
# SOLANA_CLUSTER is the only switch between devnet (the default, test money) and mainnet-beta (real USDC). Set it to
# mainnet-beta and everything follows: the USDC mint (the real one, the default), the explorer links, the role keys, the house and
# bot rules and every optional feature. There is no second "enable mainnet" flag and no per-feature mainnet flag.
# What stays is a configuration check, not a legal one: with mainnet-beta the deployment must also set SOLANA_RPC_URL,
# SETTLEMENT_AUTHORITY_SECRET_KEY and PLATFORM_WALLET_ADDRESS (and VRF_SECRET_KEY while FEATURE_VRF=true or FEATURE_PACKS=true), and must carry no devnet
# value (a devnet RPC, a test USDC_MINT, FAUCET_MINT_AUTHORITY_SECRET_KEY). Otherwise /api/health answers 503
# mainnet_config_incomplete or cluster_config_conflict (naming the variables) and every money route refuses. Mainnet also needs
# SELLER_ALLOWLIST (below): empty means nobody may sell on mainnet; `*` means everybody.
# NEXT_PUBLIC_SOLANA_NETWORK follows SOLANA_CLUSTER at build time when it is unset (next.config.js); if both are set they must agree.
SOLANA_CLUSTER=devnet
# Server-side RPC, may carry an API key. Public devnet works for development; when it answers 429 (rate limit) the app pauses that endpoint for
# 30 to 60 seconds and tries the fallbacks, so for steady use put a devnet RPC URL of your own (Helius, QuickNode, Alchemy) here. The browser
# uses NEXT_PUBLIC_SOLANA_RPC_PUBLIC below.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Comma-separated fallbacks tried in order when the primary fails or times out.
SOLANA_RPC_FALLBACK_URLS=
# Only for `npm run devnet:bootstrap` (read from the shell or this file): its devnet RPC (default: the public devnet), the keys file it creates
# and reads (default: ~/.hammerprice/devnet-keys.json) and the address the minted cards' metadata points at (default: NEXT_PUBLIC_SITE_URL, else the live site).
# DEVNET_RPC_URL=
# HP_KEYS_FILE=
# HP_PUBLIC_URL=
# Optional: a DAS-capable RPC endpoint for reading assets (falls back to the RPC above).
# DAS_RPC_URL=
# Browser-side settings. Clean values only: one URL, no spaces, no trailing comment (a real
# production value once held "https://host      # Client-safe (no key)" and was inlined as is).
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_PUBLIC=https://api.devnet.solana.com
# The test USDC mint (created by the devnet bootstrap script) and the fee wallet's public key.
USDC_MINT=
NEXT_PUBLIC_USDC_MINT=
PLATFORM_WALLET_ADDRESS=
NEXT_PUBLIC_PLATFORM_WALLET_ADDRESS=
# Platform fee in basis points (250 = 2.5%). An empty or invalid value falls back to 250, never 0.
PLATFORM_FEE_BPS=250

# --- signing keys (devnet only, server only) --------------------------------------------------
# Devnet keypairs as JSON arrays of 64 numbers (solana-keygen new --outfile ...). The settlement authority
# pays fees and account rent and is a required signer of the settlement; it holds no authority over
# any buyer or seller asset. Never NEXT_PUBLIC_, never logged.
SETTLEMENT_AUTHORITY_SECRET_KEY=
HOUSE_SELLER_SECRET_KEY=
FAUCET_MINT_AUTHORITY_SECRET_KEY=

# --- optional tuning -------------------------------------------------------------------------
# Comma-separated wallets that may start and end the house show. Empty: house-only operator.
# OPERATOR_WALLETS=
# Comma-separated public keys of the wallets that may open the admin panel (/admin). Empty: OPERATOR_WALLETS decides; both empty: the panel answers 404 to everyone.
# ADMIN_WALLETS=
# Comma-separated wallets allowed to create shows. Empty: any signed-in wallet on devnet, nobody on mainnet. `*`: any signed-in wallet.
# SELLER_ALLOWLIST=
# Packs: seconds a third-party pack operator has to deliver a drawn card before the sale counts as undelivered (1 hour to 7 days). Default 86400 (24 hours).
# PACK_DELIVERY_DEADLINE_S=
# Daily caps on what the settlement authority sponsors (about 0.008 SOL per settlement). Defaults 40 and 120.
# Pack sales count in their own counters with the same limits, so they cannot use up the auction budget.
# SA_THIRD_PARTY_SETTLEMENTS_PER_DAY=40
# SA_HOUSE_SETTLEMENTS_PER_DAY=120
# Off Vercel the client-address headers are written by the client and are ignored. Set true ONLY behind a proxy of yours that sets x-real-ip.
# TRUST_PROXY_HEADERS=false
# Seconds buyer and seller have to sign after the hammer. Default 900.
# SETTLEMENT_WINDOW_S=900
# Who pays network fees: platform (default on devnet) or buyer (default on mainnet).
# FEE_PAYER=platform
# House bidders on the devnet house show (labelled "house paddle" in the room).
# HOUSE_BOTS_ENABLED=false
# Overrides the Collector Crypt vault API base. Leave UNSET rather than empty: an empty string
# breaks `new URL`, and the code default applies when it is unset.
# COLLECTOR_CRYPT_API=https://api.collectorcrypt.com
# Absolute origin for sitemap.xml, robots.txt and Open Graph URLs. Production only; leave unset on
# previews so they use their own URL.
# NEXT_PUBLIC_SITE_URL=https://hammerprice-earn.vercel.app

# --- optional features (each OFF unless its variable is exactly "true") ---------------------
# FEATURE_<NAME>=true switches a feature on for this deployment; a row in app_flags with the lower-case name set to false is the
# ops kill switch on top (it can only switch a feature off). A feature that is off answers 404 feature_off as if it did not exist.
# They follow SOLANA_CLUSTER like everything else: no feature has its own mainnet flag.
# This file switches on what runs without an outside account. Video and Telegram stay off: they need a media server and a bot token.
FEATURE_VRF=true
FEATURE_TIMED=true
FEATURE_VIDEO=false
FEATURE_AI=true
FEATURE_CHAT=true
FEATURE_PACKS=true
FEATURE_TELEGRAM=false

# Verifiable random order of the lots (FEATURE_VRF) and the draw of the packs (FEATURE_PACKS). Its own ed25519 key (never the settlement authority's),
# secret, server only. Local: the `echo` line at the top generates one.
# VRF_SECRET_KEY=
# The signature of the one-time registration memo that announces the public key (public).
# VRF_REGISTRATION_TX=
# Slots to wait after the commit before the beacon block, and how long a draw may stay unrevealed (seconds) before the catalogue order applies.
# VRF_BEACON_OFFSET_SLOTS=32
# VRF_REVEAL_WINDOW_HOUSE_S=120
# VRF_REVEAL_WINDOW_SELLER_S=900
# Daily cap on the memo transactions the settlement authority pays for draws.
# SA_VRF_MEMOS_PER_DAY=200

# Timed auctions (FEATURE_TIMED). The house timed lot runs this long (seconds). TIMED_MIN_DURATION_S lowers the minimum for tests only
# and never applies on mainnet.
# TIMED_HOUSE_DURATION_S=3600
# How many timed house auctions run at once (0 to 4, default 2) and how long the daily sweep keeps ended house (demo) shows with their bids
# and events (1 to 365 days, default 7, or "off"). Real rooms and real settlements are never deleted.
# TIMED_HOUSE_COUNT=2
# HOUSE_RETENTION_DAYS=7
# Housekeeping (chat and demo-room retention, draws, packs, Telegram reminders, lapsed settlements) runs daily from Vercel Cron (vercel.json) and, for hosts
# without a scheduler, a read of the schedule also starts it in the background at most once per this many seconds per server instance. 0 switches that off.
# HOUSEKEEPING_INTERVAL_S=900
# Milliseconds a room's live snapshot is shared inside one function instance (0 to 2000, default 500): higher means less database load.
# LIVE_SNAPSHOT_MEMO_MS=500
# TIMED_MIN_DURATION_S=

# Optional live video (FEATURE_VIDEO): the seller ticks a checkbox per show, viewers click to load. MEDIA_SERVER_* are the existing
# Bonkstream MediaMTX server's names; the publish user and password and the API key are secrets and never reach the browser.
# Unset: no camera, the room shows the lot's own slab image. NEXT_PUBLIC_MEDIA_SERVER_URL is a host name (no scheme) and is allowed in the CSP.
# MEDIA_SERVER_URL=
# NEXT_PUBLIC_MEDIA_SERVER_URL=
# MEDIA_SERVER_API_URL=
# MEDIA_SERVER_API_KEY=
# MEDIAMTX_PUBLISH_USER=
# MEDIAMTX_PUBLISH_PASS=
# MEDIA_SERVER_HLS_PORT=8888
# MEDIA_SERVER_WEBRTC_PORT=8889
# NEXT_PUBLIC_MEDIA_SERVER_HLS_PORT=8888
# Paths on the media server: everything of ours lives under VIDEO_PATH_PREFIX; the house show has one fixed path; who may send (operator or seller).
# VIDEO_PATH_PREFIX=hp
# VIDEO_HOUSE_PATH=house
# VIDEO_SENDERS=operator
# HOUSE_VIDEO_ENABLED=false

# AI features (FEATURE_AI): Google Gemini, called from the server only, billed to whoever owns the key. AI_PROVIDER picks
# how (the same small adapter, the same cost caps): gemini-api (the default: an AI Studio API key in GEMINI_API_KEY) or vertex
# (Vertex AI: a service account JSON in GCP_SERVICE_ACCOUNT_JSON, raw or base64, signed with node crypto, no SDK; needs
# GOOGLE_CLOUD_PROJECT). Try the key first; if Google bills the credit through Vertex instead, switch AI_PROVIDER.
# No key (or no service account): the room assistant answers from the FAQ search and listing drafts come from a template, at no cost. The agent page
# (/ai) needs a key, because the model picks its tools: a Google AI Studio key (aistudio.google.com/apikey) in GEMINI_API_KEY is enough.
# Every AI text is labelled "AI draft, seller reviews" (listing) or as AI (assistant), and the assistant answers only the person who asked.
# AI_PROVIDER=gemini-api
# GEMINI_API_KEY=
# GCP_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# The model id (the current Gemini Flash-Lite id; read the model page before changing it).
# AI_MODEL=gemini-3.5-flash-lite
# Hard cost caps, the same for both providers: a daily and a monthly budget in US dollars (calls past it fall back to the template),
# credit packs a wallet may buy per day (devnet only), and the daily cap on credit purchases the settlement authority sponsors.
AI_DAILY_BUDGET_USD=0.5
AI_MONTHLY_BUDGET_USD=5
# AI_PACKS_PER_WALLET_DAY=3
# SA_CREDIT_PURCHASES_PER_DAY=60
# Rate limits of the AI routes: per wallet per minute, hour and day, and per client address (all wallets together).
# A value that is not a whole number of 1 or more is the default. AI_MAX_CONCURRENT caps model calls in flight; the breaker stops model calls
# after AI_BREAKER_ERRORS upstream failures within AI_BREAKER_WINDOW_S seconds (the template or the FAQ answers meanwhile).
# AI_RATE_PER_MIN=6
# AI_RATE_PER_HOUR=60
# AI_RATE_PER_DAY=300
# AI_RATE_IP_PER_MIN=20
# AI_RATE_IP_PER_HOUR=100
# AI_RATE_IP_PER_DAY=100
# AI_MAX_CONCURRENT=8
# AI_BREAKER_ERRORS=5
# AI_BREAKER_WINDOW_S=120
# AI_FREE=true: AI costs no credits (no debit, no purchase, every signed-in wallet may use it). The caps above, the rate limits and the kill switch stay on.
AI_FREE=true
# Tests only, ignored on a production deployment: AI_MOCK=1 for a server-side fake model.
# AI_MOCK=

# Packs (FEATURE_PACKS): a pack operator (a seller, or the house) offers real cards from a committed pool with published odds; the draw
# is an ECVRF draw, delivery is the same co-signed transaction as an auction (Hammerprice is the intermediary and holds neither the
# money nor the card). The draw key is VRF_SECRET_KEY (without it no pack can be published or bought; FEATURE_VRF is not needed). The 18+ confirmation, the per-wallet daily cap and the operator's pool commitment
# are built in; packs need no variable of their own.

# Telegram notifications (FEATURE_TELEGRAM): a Bot API webhook on this deployment (POST /api/telegram/webhook), no server of its own. Create the bot once with
# @BotFather and use ONE bot per environment (a test bot for devnet and previews, another for mainnet). The token and the webhook secret are secret, server
# only; the username (without the @) builds the t.me deep link. Register the webhook once with the Bot API `setWebhook` call (url: https://<your-host>/api/telegram/webhook, plus secret_token).
# The webhook secret: 16 to 256 characters of A-Z a-z 0-9 _ - (openssl rand -hex 32 works).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# Pre-moderated chat (FEATURE_CHAT): needs no variable. Messages wait for the room operator (the seller; OPERATOR_WALLETS for the house show).

# The other site of the two (devnet <-> mainnet): an https URL on a different host. Shown as "try with test money" / "go to mainnet". Optional, public.
# NEXT_PUBLIC_COUNTERPART_URL=
